# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- Rust ----------
/target
Cargo.lock.bak

# ---------- 本机配置与密钥 ----------
# 程序把 config.json / secrets.json 放在 %APPDATA%\PopDict\，本来就不在
# 仓库内。这里再兜一层，防止有人手动拷进来后误提交。
secrets.json
config.json

# ---------- 运行期产物 ----------
*.log
run_live.log
bt.txt

# ---------- 一次性调试产物 ----------
# 截图、探针输出、临时对比图等，不属于源码
*.bmp
icon_preview.bmp
_note_*.md

# _live_drag.py 跑完会留下实机浮层截图，属于本地验证产物。
# 保留 *_x4.png 也一并排除（放大查看用的中间图）。
live_drag*.png
*_x4.png
screen_*.png
pill_shot_*.png

# 图标设计候选稿（一轮轮生成的备选方案，3.4MB）。
# 真正的源图是 assets/icon_source.png，成品是根目录的 popdict.ico，
# 中间预览由 py_mkicon.py 随时可重新生成，无需入库。
/icons/*.png
/icons/preview/

# ---------- 操作系统 ----------
Thumbs.db
desktop.ini
.DS_Store
