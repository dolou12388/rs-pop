# ==========================================================================
#  换行符策略 —— 这个文件不是可选的
# ==========================================================================
#
# 为什么必须显式声明：
#
#   `启动划词.bat` 与 `启动划词.vbs` 是 GBK 编码 + CRLF 换行。cmd.exe
#   解析 .bat 时只认 \r\n，遇到 LF-only 会把后续几行拼成一条命令，直接
#   闪退且报错信息完全看不出原因（详见报告 12.1）。
#
#   如果依赖 core.autocrlf=true，Git 会在提交时按"文本文件"处理，把
#   CRLF 剥成 LF。实测确认过这个破坏：磁盘上 83 个 CRLF，暂存区变成 0 个。
#   别人 clone 下来就是一个必然闪退的启动器。
#
#   所以这些文件用 `-text` 声明：禁止一切换行与编码转换，原样存取。
#   代价是失去行级 diff —— 但它们是脚本生成的一次性产物，由
#   _mkbat.py / _mkvbs2.py 重建，不靠 git diff 维护。
#
# ==========================================================================

# 启动器：GBK + CRLF，必须逐字节保真
*.bat           -text
*.vbs           -text

# 图标与图像：二进制，同样不做转换
*.ico           -text
*.png           -text
*.bmp           -text

# --------------------------------------------------------------------------
#  其余文本文件统一 LF
# --------------------------------------------------------------------------
# 纯 ASCII / UTF-8 源码，LF 更通用，避免不同平台 clone 出不同结果。
*.py            text eol=lf
*.rs            text eol=lf
*.toml          text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.ps1           text eol=lf
*.json          text eol=lf
*.txt           text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
